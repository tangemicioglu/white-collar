{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://white-collar.local/schemas/plan-v1.schema.json",
  "title": "white-collar plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "app", "target", "policy", "operations", "write"],
  "properties": {
    "schema": {"const": "white-collar.plan/v1"},
    "app": {"enum": ["word", "slides", "mail"]},
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "expected_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {"id": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "policy": {"enum": ["read-only", "review", "edit", "send"]},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "find", "replace"],
            "properties": {
              "op": {"const": "replace_text"},
              "find": {"type": "string", "minLength": 1},
              "replace": {"type": "string"},
              "occurrence": {"enum": ["first", "all"], "default": "all"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op"],
            "properties": {
              "op": {"type": "string", "pattern": "^word_(live|screen)_"},
              "args": {"type": "object"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op"],
            "properties": {
              "op": {"type": "string", "pattern": "^slides_(live|screen)_"},
              "args": {"type": "object"}
            }
          },
          {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op"],
                "properties": {"op": {"enum": ["mail_live_mark_read", "mail_live_mark_unread", "mail_live_delete", "mail_live_send"]}}
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "args"],
                "properties": {
                  "op": {"const": "mail_live_move"},
                  "args": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["folder"],
                    "properties": {"folder": {"type": "string", "minLength": 1}}
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "args"],
                "properties": {
                  "op": {"const": "mail_live_create_draft"},
                  "args": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["to", "subject", "body"],
                    "properties": {
                      "to": {"type": "string", "minLength": 1},
                      "cc": {"type": "string"},
                      "bcc": {"type": "string"},
                      "subject": {"type": "string", "minLength": 1},
                      "body": {"type": "string"}
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    },
    "write": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "none"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "path"],
          "properties": {"mode": {"const": "save-as"}, "path": {"type": "string", "minLength": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "snapshot"],
          "properties": {"mode": {"const": "in-place"}, "snapshot": {"type": "string", "minLength": 1}}
        }
      ]
    }
  }
}

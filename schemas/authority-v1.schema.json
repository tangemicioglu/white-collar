{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://white-collar.local/schemas/authority-v1.schema.json",
  "title": "white-collar authority v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policies", "backends"],
  "properties": {
    "schema": {"const": "white-collar.authority/v1"},
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "word": {"enum": ["read-only", "review", "edit"]},
        "slides": {"enum": ["read-only", "review", "edit"]},
        "mail": {"enum": ["read-only", "review", "edit"]}
      }
    },
    "backends": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["word:com", "slides:com", "mail:com"]}
    }
  }
}

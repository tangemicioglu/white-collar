{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://white-collar.local/schemas/grant-v1.schema.json",
  "title": "white-collar protected grant payload v1",
  "description": "The JSON blob stored inside OS credential storage. It is not a CLI configuration file and must not be accepted from a plan or path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "grants"],
  "properties": {
    "schema": {"const": "white-collar.grant/v1"},
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["app", "backend", "policy", "capabilities", "targets"],
        "properties": {
          "app": {"enum": ["word", "slides", "mail"]},
          "backend": {"enum": ["local", "com"]},
          "policy": {"enum": ["read-only", "review", "edit", "send"]},
          "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
